# Copy to .env in the repo root and edit. Never commit .env.
#
# On a Slurm cluster, your site's account tool (often `accounts` on a login node)
# shows SLURM_ACCOUNT and your project storage folder.

# --- local workstation (uncomment) ---
# REPO_ROOT=/path/to/safequant
# HF_HOME=/data/huggingface
# QM_ROOT=/data/quantized_models

# --- Slurm cluster (uncomment and replace placeholders) ---
# SLURM_ACCOUNT=YOUR_SLURM_ACCOUNT
# SLURM_PARTITION=YOUR_GPU_PARTITION    # a GPU with >= 40 GB fits 8B fp16
# SLURM_INTERACTIVE_PARTITION=<interactive GPU partition, 1 job per user>  # interactive_queue.sh, probe_interactive_chain.sh
# SLURM_CPU_PARTITION=YOUR_CPU_PARTITION  # optional: CPU partition for scripts/setup.sbatch (downloads only)
# SLURM_CPU_ACCOUNT=YOUR_CPU_ACCOUNT      # required with SLURM_CPU_PARTITION when CPU and GPU allocations are separate
# REPO_ROOT=/path/on/project/fs/safequant
# HF_HOME=/path/on/project/fs/hf_cache      # NOT $HOME (small quota)
# QM_ROOT=/path/on/project/fs/quantized_models
# CONDA_ENV=/path/to/conda_envs/sq_clean    # or an env name
# AGENV=/path/to/conda_envs/sq_autogptq
# AQLM_REPO=/path/to/AQLM
# CONDA_SH=                      # path to conda.sh; leave empty if `module load` puts conda on PATH
# MODULES=                       # space-separated modules to load (check `module avail`)
# CUDA_HOME=                     # leave unset to use the module's CUDA
#
# Submit with:  bash scripts/submit.sh scripts/setup.sbatch
