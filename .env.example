# Copy to .env in the repo root and edit. Never commit .env.
#
# On a Slurm cluster, run `accounts` on the login node for SLURM_ACCOUNT
# and your project storage folder.

# --- local workstation (uncomment) ---
# REPO_ROOT=/path/to/safequant
# HF_HOME=/data/huggingface
# QM_ROOT=/data/quantized_models

# --- Slurm cluster (uncomment and replace placeholders) ---
# SLURM_ACCOUNT=YOUR_SLURM_ACCOUNT
# OCEAN_ALLOCATION=YOUR_OCEAN_ALLOCATION
# REPO_ROOT=/path/to/projects/safequant
# HF_HOME=/ocean/projects/YOUR_OCEAN_ALLOCATION/youruser/.cache/huggingface
# QM_ROOT=/ocean/projects/YOUR_OCEAN_ALLOCATION/youruser/quantized_models
# CONDA_ENV=/ocean/projects/YOUR_OCEAN_ALLOCATION/youruser/conda_envs/sq_clean
# AGENV=/ocean/projects/YOUR_OCEAN_ALLOCATION/youruser/conda_envs/sq_autogptq
# AQLM_REPO=/path/to/projects/AQLM

# --- NCSA Delta (uncomment; PLACEHOLDERS - confirm with `accounts`, `module avail`,
#     and the Delta user guide) ---
# SLURM_ACCOUNT=<from `accounts`; Delta GPU accounts usually end in -delta-gpu>
# SLURM_PARTITION=gpuA100x4      # gpuA40x4 is cheaper and fine for 8B fp16; max time 48 h
# SLURM_CPU_PARTITION=cpu        # CPU partition for scripts/tests/delta_setup.sbatch (downloads only)
# REPO_ROOT=/path/on/project/or/work/fs/safequant
# HF_HOME=/path/on/project/or/work/fs/hf_cache      # NOT $HOME (small quota)
# QM_ROOT=/path/on/project/or/work/fs/quantized_models
# CONDA_ENV=/path/to/conda_envs/sq_clean            # or an env name
# AGENV=/path/to/conda_envs/sq_autogptq
# CONDA_SH=                      # path to conda.sh; leave empty if `module load` puts conda on PATH
# MODULES=                       # e.g. "anaconda3_gpu"  (space-separated; check `module avail`)
# CUDA_HOME=                     # leave unset to use the module's CUDA
#
# Submit with:  bash scripts/submit.sh scripts/tests/00_env_check.sbatch
